<?xml version="1.0" encoding="UTF-8"?>
<!-- AcquisitionApp integration-test config -->
<sdr_acquisition version="2.0">

  <scanner_id>scanner-test-0</scanner_id>

  <amqp>
    <url>amqp://localhost:5673</url>
    <username>sdr_ctrl</username>
    <password>test_password</password>
    <detection_topic>rf.detections</detection_topic>
    <task_request_queue>sdr.task.request</task_request_queue>
    <task_response_queue>sdr.task.response</task_response_queue>
    <reconnect_interval_sec>3</reconnect_interval_sec>
  </amqp>

  <device>
    <rx_channels>1</rx_channels>
    <sample_rate_sps>2000000</sample_rate_sps>
    <rx_gain_db>40</rx_gain_db>
    <bandwidth_hz>2000000</bandwidth_hz>
  </device>

  <sweep>
    <start_hz>100000000</start_hz>
    <stop_hz>102000000</stop_hz>
    <dwell_samples>200000</dwell_samples>
    <fft_size>1024</fft_size>
    <usable_bw_fraction>0.80</usable_bw_fraction>
    <threshold_db>3.0</threshold_db>
    <min_signal_bw_hz>1000</min_signal_bw_hz>
    <settle_samples>0</settle_samples>
  </sweep>

  <rank>1</rank>

  <receiver>
    <local_ip>127.0.0.1</local_ip>
    <port>0</port>
  </receiver>


  <!-- Threat detection disabled in test environment -->
  <threat>
    <enabled>false</enabled>
    <gps_enabled>false</gps_enabled>
  </threat>

</sdr_acquisition>
