<?xml version="1.0" encoding="UTF-8"?>
<!--
  SDR Acquisition — Spectrum Scanner Configuration
  ─────────────────────────────────────────────────────────────────────────
  The acquisition binary is a CLIENT of the sdr_controller (task manager).
  It submits a SCAN task via AMQP and receives CF32 IQ data over UDP.
  It does NOT open SoapySDR directly.

  Build:  cmake -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build
  Run:    ./build/sdr_acquisition config/scanner.xml
  DB:     psql -U sdr -d sdr_scanner -f schema/init.sql   (run once first)
-->
<sdr_acquisition version="2.0">

  <!-- Unique name for this scanner instance — appears in DB and AMQP messages -->
  <scanner_id>scanner-0</scanner_id>

  <!-- ── AMQP broker ────────────────────────────────────────────────────── -->
  <!-- Same broker used by the sdr_controller.
       detection_topic: where this scanner publishes RF detection events.
       task_request_queue / task_response_queue: controller's RRTM queues. -->
  <amqp>
    <url>amqp://localhost:5672</url>
    <username>scanner</username>
    <password>CHANGE_ME</password>
    <detection_topic>rf.detections</detection_topic>
    <task_request_queue>sdr.task.request</task_request_queue>
    <task_response_queue>sdr.task.response</task_response_queue>
    <reconnect_interval_sec>5</reconnect_interval_sec>
  </amqp>

  <!-- ── PostgreSQL ────────────────────────────────────────────────────── -->
  <database>
    <host>localhost</host>
    <port>5432</port>
    <name>sdr_scanner</name>
    <user>sdr</user>
    <password>CHANGE_ME</password>
  </database>

  <!-- ── RF parameters requested from the controller ───────────────────── -->
  <!-- The controller allocates a physical device and channels.
       This block describes what the acquisition needs, not which hardware. -->
  <device>
    <rx_channels>1</rx_channels>
    <sample_rate_sps>10000000</sample_rate_sps>  <!-- 10 MSPS -->
    <rx_gain_db>40</rx_gain_db>
    <bandwidth_hz>10000000</bandwidth_hz>
  </device>

  <!-- ── Sweep parameters ───────────────────────────────────────────────── -->
  <sweep>
    <start_hz>70000000</start_hz>       <!-- 70 MHz -->
    <stop_hz>1000000000</stop_hz>       <!-- 1 GHz  -->
    <dwell_samples>4096</dwell_samples>
    <fft_size>4096</fft_size>
    <usable_bw_fraction>0.80</usable_bw_fraction>
    <threshold_db>10.0</threshold_db>
    <min_signal_bw_hz>2500</min_signal_bw_hz>
    <settle_samples>512</settle_samples>
  </sweep>

  <!-- ── UDP IQ receiver ────────────────────────────────────────────────── -->
  <!-- local_ip: IP the acquisition binds to receive IQ data from the
       controller.  Must be routable FROM the controller host.
       Set to the acquisition host's IP (not 0.0.0.0) when controller and
       acquisition run on different machines.
       port: 0 = OS-assigned (recommended); set a fixed value if a firewall
       rule is required. -->
  <receiver>
    <local_ip>127.0.0.1</local_ip>
    <port>0</port>
  </receiver>

  <!-- ── Threat detection ─────────────────────────────────────────────────── -->
  <!-- Master switch: set <enabled> to true to activate any sub-feature.
       GPS monitor requires hardware capable of reaching L1 (1575 MHz) —
       RTL-SDR v3 tops out at ~1.7 GHz (marginal); HackRF/USRP recommended.
       Content-layer validators (ADS-B, AIS, etc.) run inside DemodApp and
       are controlled by the matching flags in demod.xml <threat>. -->
  <threat>
    <enabled>false</enabled>

    <!-- GPS L1/L2/L5 jamming and spoofing monitor -->
    <gps_enabled>false</gps_enabled>
    <!-- dB above EMA baseline to declare a jammer -->
    <gps_jammer_threshold_db>20.0</gps_jammer_threshold_db>
    <!-- Any GPS-band signal above this power (dBm) = spoofing suspect.
         Real GPS signals are always ~20 dB below the noise floor (~-130 dBm). -->
    <gps_spoof_detectable_dbm>-110.0</gps_spoof_detectable_dbm>
    <!-- Seconds between L1/L2/L5 checks (reduces sweep interruption) -->
    <gps_check_interval_s>30.0</gps_check_interval_s>

    <!-- Content-layer validators (run in DemodApp — flags mirrored in demod.xml) -->
    <!-- Enable/disable individual validators independently -->
    <adsb_enabled>true</adsb_enabled>       <!-- ADS-B impossible physics + CRC rate -->
    <ais_enabled>true</ais_enabled>         <!-- AIS impossible vessel speed / bad MMSI -->
    <eas_enabled>true</eas_enabled>         <!-- EAS/SAME invalid originator or rare event -->
    <dsc_enabled>true</dsc_enabled>         <!-- DSC fake distress MMSI detection -->
    <p25_rogue_enabled>true</p25_rogue_enabled> <!-- P25 unexpected WACN change -->

    <!-- AMQP topic that DemodApp publishes alerts to (AcquisitionApp consumes) -->
    <alert_topic>rf.alerts</alert_topic>
  </threat>

  <!-- P25 trunked voice channel follower (disabled by default).
       Enable to have AcquisitionApp retune to voice channels when DemodApp
       publishes channel grants on rf.p25.grants.
       tg_whitelist: space-separated talk group IDs to follow (empty = all).
       Audio decoding (IMBE→PCM→SpeechApp) is not wired here. -->
  <p25>
    <enabled>false</enabled>
    <grant_topic>rf.p25.grants</grant_topic>
    <capture_s>3.0</capture_s>
    <rank>3</rank>
    <tg_whitelist></tg_whitelist>
  </p25>

</sdr_acquisition>
